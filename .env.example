# ============================================
# Environment Variables — Lesson Dashboard
# ============================================
#
# WHAT ARE ENVIRONMENT VARIABLES?
# Environment variables are configuration values that live OUTSIDE your code.
# They let you change how the app behaves without modifying source code.
#
# WHY USE THEM?
# 1. SECURITY: Secrets (passwords, API keys, JWT secrets) should never be
#    committed to Git. Environment variables keep them separate from code.
# 2. FLEXIBILITY: The same Docker image can run in dev, staging, and production
#    with different configs — just change the env vars.
# 3. TWELVE-FACTOR APP: This is a best practice from the 12-factor methodology
#    (https://12factor.net/config) — store config in the environment.
#
# HOW TO USE:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Docker Compose reads .env automatically
# 4. NEVER commit the .env file to Git (it's in .gitignore)

# ── JWT Configuration ─────────────────────────────────
# Secret key for signing JWT tokens (CHANGE THIS IN PRODUCTION!)
# Must be at least 32 characters for HS256 algorithm security
JWT_SECRET=mySecretKeyForJWTtokenSigning2024LessonDashboard!

# Token expiration in milliseconds (24 hours = 86400000)
JWT_EXPIRATION=86400000

# ── Spring Boot Profile ───────────────────────────────
# Controls which application properties profile is active
# Options: default, production
SPRING_PROFILES_ACTIVE=default
